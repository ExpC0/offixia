<?xml version="1.0" encoding="utf-8"?>
<!-- Background layer of the adaptive icon. A flat gradient rather than art:
     the launcher masks this to whatever shape the device uses, so anything
     with detail near the edge would be cropped unpredictably. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#4C6EF5"
        android:endColor="#304BBF"
        android:type="linear" />
</shape>
